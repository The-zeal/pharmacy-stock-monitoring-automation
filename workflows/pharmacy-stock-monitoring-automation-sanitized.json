    {
      "parameters": {
        "jsCode": "const items = $input.all().map(item => item.json);\n\nconst lowStock = items.filter(\n  item => item.status === \"LOW STOCK\"\n);\n\nconst invalid = items.filter(\n  item => item.status === \"INVALID DATA\"\n);\n\nconst date = new Date().toLocaleString(\"en-NG\", {\n  timeZone: \"Africa/Lagos\",\n  dateStyle: \"medium\",\n  timeStyle: \"short\"\n});\n\nconst escapeHtml = value =>\n  String(value ?? \"\").replace(/[&<>\"']/g, char => ({\n    \"&\": \"&amp;\",\n    \"<\": \"&lt;\",\n    \">\": \"&gt;\",\n    '\"': \"&quot;\",\n    \"'\": \"&#39;\"\n  })[char]);\n\nconst rows = items.map(item => {\n  const status = item.status ?? \"UNKNOWN\";\n  const color = status === \"LOW STOCK\"\n    ? \"#b91c1c\"\n    : status === \"SUFFICIENT\"\n      ? \"#15803d\"\n      : \"#92400e\";\n\n  return `\n    <tr>\n      <td>${escapeHtml(item.product)}</td>\n      <td>${escapeHtml(item.quantity)}</td>\n      <td>${escapeHtml(item.minimum_stock)}</td>\n      <td>${escapeHtml(item.quantity_difference ?? \"N/A\")}</td>\n      <td style=\"color:${color};font-weight:bold\">\n        ${escapeHtml(status)}\n      </td>\n    </tr>`;\n}).join(\"\");\n\nconst html = `\n  <h2>Pharmacy Inventory Report</h2>\n  <p><strong>Report generated:</strong> ${escapeHtml(date)}</p>\n  <p><strong>Products checked:</strong> ${items.length}</p>\n  <p><strong>Low-stock products:</strong> ${lowStock.length}</p>\n  <p><strong>Invalid records:</strong> ${invalid.length}</p>\n\n  <table border=\"1\" cellpadding=\"8\"\n    cellspacing=\"0\" style=\"border-collapse:collapse\">\n    <thead>\n      <tr>\n        <th>Product</th>\n        <th>Current Stock</th>\n        <th>Minimum Stock</th>\n        <th>Difference</th>\n        <th>Status</th>\n      </tr>\n    </thead>\n    <tbody>${rows}</tbody>\n  </table>\n\n  <p>Please review low-stock products and arrange replenishment\n  according to approved pharmacy procedures.</p>\n`;\n\nreturn [{\n  json: {\n    report_date: date,\n    total_products: items.length,\n    low_stock_count: lowStock.length,\n    invalid_count: invalid.length,\n    html_report: html\n  }\n}];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        624,
        -288
      ],
