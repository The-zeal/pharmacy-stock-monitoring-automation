{
  "name": "Pharmacy Stock Monitoring Automation",
  "nodes": [
    {
      "parameters": {
        "jsCode": "\nconst items = $input.all();\n\nreturn items.map(item => {\n  const row = item.json;\n\n  const product = String(row.product ?? \"\").trim();\n\n  // Preserve blank values before converting to numbers.\n  const quantityRaw = row.quantity;\n  const minimumRaw = row.minimum_stock;\n\n  const quantityIsBlank =\n    quantityRaw === null ||\n    quantityRaw === undefined ||\n    String(quantityRaw).trim() === \"\";\n\n  const minimumIsBlank =\n    minimumRaw === null ||\n    minimumRaw === undefined ||\n    String(minimumRaw).trim() === \"\";\n\n  const quantity = Number(quantityRaw);\n  const minimum = Number(minimumRaw);\n\n  const invalid =\n    !product ||\n    quantityIsBlank ||\n    minimumIsBlank ||\n    !Number.isFinite(quantity) ||\n    !Number.isFinite(minimum) ||\n    quantity < 0 ||\n    minimum < 0;\n\n  if (invalid) {\n    return {\n      json: {\n        ...row,\n        status: \"INVALID DATA\",\n        quantity_difference: null\n      }\n    };\n  }\n\n  return {\n    json: {\n      ...row,\n      quantity,\n      minimum_stock: minimum,\n      quantity_difference: quantity - minimum,\n      status: quantity < minimum\n        ? \"LOW STOCK\"\n        : \"SUFFICIENT\"\n    }\n  };\n});\n"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        416,
        0
      ],
      "id": "27f8d0db-7e41-4e6a-8463-bd1af585bde1",
