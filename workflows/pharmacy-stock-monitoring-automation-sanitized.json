      "parameters": {
        "jsCode": "\nconst items = $input.all().map(item => item.json);\n\nconst escapeHtml = value =>\n  String(value ?? \"\").replace(/[&<>\"']/g, char => ({\n    \"&\": \"&amp;\",\n    \"<\": \"&lt;\",\n    \">\": \"&gt;\",\n    '\"': \"&quot;\",\n    \"'\": \"&#39;\"\n  })[char]);\n\nconst date = new Date().toLocaleString(\"en-NG\", {\n  timeZone: \"Africa/Lagos\",\n  dateStyle: \"medium\",\n  timeStyle: \"short\"\n});\n\nconst rows = items.map(item => `\n  <tr>\n    <td>${escapeHtml(item.product)}</td>\n    <td>${escapeHtml(item.quantity)}</td>\n    <td>${escapeHtml(item.minimum_stock)}</td>\n    <td>${escapeHtml(item.quantity_difference)}</td>\n  </tr>\n`).join(\"\");\n\nconst html = `\n  <h2>Pharmacy Low-Stock Alert</h2>\n  <p><strong>Generated:</strong> ${escapeHtml(date)}</p>\n  <p><strong>Products requiring review:</strong> ${items.length}</p>\n  <table border=\"1\" cellpadding=\"8\" cellspacing=\"0\"\n         style=\"border-collapse:collapse\">\n    <thead>\n      <tr>\n        <th>Product</th>\n        <th>Current Stock</th>\n        <th>Minimum Stock</th>\n        <th>Difference</th>\n      </tr>\n    </thead>\n    <tbody>${rows}</tbody>\n  </table>\n  <p>Please review these items and arrange replenishment\n  according to approved pharmacy procedures.</p>\n`;\n\nreturn [{\n  json: {\n    alert_date: date,\n    low_stock_count: items.length,\n    alert_subject: `Pharmacy Low-Stock Alert — ${items.length} item(s)`,\n    html_alert: html,\n\n    alert_products: items.map(item => ({\n      product: item.product,\n      quantity: item.quantity,\n      minimum_stock: item.minimum_stock\n    }))\n  }\n}];\n"
      },
