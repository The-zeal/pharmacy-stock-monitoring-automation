    {
      "parameters": {
        "jsCode": "\nconst items = $input.all();\n\nreturn items.map(item => {\n  const row = item.json;\n\n  const status = String(row.status ?? \"\")\n    .trim()\n    .toUpperCase();\n\n  const alertActive =\n    row.alert_active === true ||\n    String(row.alert_active).toLowerCase() === \"true\";\n\n  let action = \"NONE\";\n\n  if (status === \"LOW STOCK\" && !alertActive) {\n    action = \"SEND_ALERT\";\n  } else if (status === \"SUFFICIENT\" && alertActive) {\n    action = \"RESET_ALERT\";\n  }\n\n  return {\n    json: {\n      ...row,\n      alert_action: action\n    }\n  };\n});\n\n"
      },
